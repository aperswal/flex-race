{
  "name": "flex-race",
  "version": "0.1.0",
  "description": "Race OpenAI's flex tier against a deadline on the Responses API, falling back to the default tier.",
  "license": "MIT",
  "author": "Aditya Perswal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aperswal/flex-race.git"
  },
  "homepage": "https://github.com/aperswal/flex-race#readme",
  "bugs": {
    "url": "https://github.com/aperswal/flex-race/issues"
  },
  "keywords": [
    "openai",
    "flex",
    "service_tier",
    "responses",
    "deadline"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "openai": ">=6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "openai": "^7.23.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
